<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>RescueDrive</AssemblyName>
    <RootNamespace>RescueDrive</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>7.3</LangVersion>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Claude Rescue Drive</Product>
    <AssemblyTitle>Claude Rescue Drive Installer</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- payload.zip is generated by Build-Exe before compiling -->
    <EmbeddedResource Include="payload.zip" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
